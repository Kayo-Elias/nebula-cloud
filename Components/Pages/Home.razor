@page "/"

<PageTitle>Nebula Cloud</PageTitle>

<MudPaper Square="true" Elevation="0" Class="d-flex align-center"
          Style="background-color: #F5F6FA; min-height: calc(100vh - 64px); overflow-x: clip;">
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">

        <MudGrid Spacing="6">

            <MudItem xs="12" md="6" Class="d-flex flex-column justify-center">
                <MudText Typo="Typo.h2" Style="color: #24003B;">
                    <strong>Sua infraestrutura de nuvem, mais rápida e inteligente.</strong>
                </MudText>

                <MudText Typo="Typo.h5" Class="mt-6" Style="color: #24003B;">
                    Armazenamento e computação com a potência do Nebula Cloud. Escalável,
                    seguro e feito para o seu negócio.
                </MudText>

                <MudStack Row="true" Breakpoint="Breakpoint.Sm" AlignItems="AlignItems.Center" Spacing="3" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               Style="font-size: 1.125rem; text-transform: none;" Class="rounded-lg">
                        Comece gratuitamente
                    </MudButton>

                    <MudButton Variant="Variant.Text" Size="Size.Large"
                               Style="color: #24003B; font-size: 1.125rem; text-transform: none;" Class="rounded-lg">
                        <u>Fale com um especialista</u>
                    </MudButton>
                </MudStack>

                </MudItem>

                <MudItem xs="12" md="6" Class="d-flex justify-right">
                    <MudImage Src="/images/nebula-cloud-back.png"
                              Alt="Ilustração de serviços de nuvem, servidores e análise de dados" Fluid="true"
                              Style="max-width: 750px;" />
                </MudItem>
            </MudGrid>

            <MudGrid Justify="Justify.Center" Spacing="4">
                <MudItem xs="6" md="3">
                    <MudPaper Height="200px" Elevation="2" Class="d-flex flex-column align-center justify-center pa-4 rounded-lg">
                        <MudIcon Icon="@Icons.Material.Outlined.Dns" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Style="color: #000000">Servidores Cloud</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudPaper Height="200px" Elevation="2" Class="d-flex flex-column align-center justify-center pa-4 rounded-lg">
                        <MudIcon Icon="@Icons.Material.Outlined.Storage" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Style="color: #000000">Banco de Dados</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudPaper Height="200px" Elevation="2" Class="d-flex flex-column align-center justify-center pa-4 rounded-lg">
                        <MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Style="color: #000000">Segurança</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudPaper Height="200px" Elevation="2" Class="d-flex flex-column align-center justify-center pa-4 rounded-lg">
                        <MudIcon Icon="@Icons.Material.Outlined.ArrowOutward" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Style="color: #000000">Escalonamento</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </MudPaper>