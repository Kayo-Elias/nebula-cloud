@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Style="background-color: #6A1B9A; color: white;">
        <a href="/" aria-label="Nebula Cloud - página inicial"
           class="d-flex align-center gap-2" style="color: inherit; text-decoration: none;">
            <img src="/images/nebula-cloud.png" alt=""
                 style="display: block; width: 100px; height: auto;" />
            <MudText Typo="Typo.h6">Nebula Cloud</MudText>
        </a>

        <MudSpacer />
        <div class="d-flex align-center gap-4">
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Large"
                       Style="text-transform: none;">Serviços</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Large"
                       Style="text-transform: none;">Preços</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Large"
                       Style="text-transform: none;">Soluções</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Large"
                       Style="text-transform: none;">Documentação</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Large"
                       Style="text-transform: none;">Entrar</MudButton>
            <MudButton Class="rounded-lg" Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Large"
                       Style="text-transform: none;">Criar Conta</MudButton>
        </div>

    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
